# ============================================================
# CNPS SAAS Analytics - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database (Supabase) ───────────────────────────────────────
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres

# Set to False in production (uses real Oracle DB)
MOCK_DATA=False

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── AI / Groq ────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Redis ────────────────────────────────────────────────────
# For local dev: redis://localhost:6379/0
# For Docker:    redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Email (Brevo) ───────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key_here
FERNET_KEY=your_fernet_key_here

# ── Frontend URL (for unsubscribe links) ────────────────────
FRONTEND_URL=https://your-domain.com

# ── Email Sender ────────────────────────────────────────────
EMAIL_SENDER_NAME=CNPS Analytics
EMAIL_SENDER_ADDRESS=your-verified@email.com

# ── Security ────────────────────────────────────────────────
UNSUBSCRIBE_SECRET=generate-a-random-string-in-production
